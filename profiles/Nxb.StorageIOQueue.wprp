<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder
  Version="1.0"
  Author="NXB Integrity Research Lab"
  Team="Observability"
  Company="NXB Integrity Research Lab"
  Comments="Bounded disk, file-system and storage I/O capture profile for authorized research experiments."
  Tag="NXB-IRL-004">
  <Profiles>
    <SystemCollector
      Id="NxbStorageIOQueueSystemCollectorFile"
      Name="NT Kernel Logger">
      <BufferSize Value="1024" />
      <Buffers Value="64" />
      <MaximumFileSize Value="512" FileMode="Circular" />
    </SystemCollector>

    <SystemCollector
      Id="NxbStorageIOQueueSystemCollectorMemory"
      Name="NT Kernel Logger">
      <BufferSize Value="1024" />
      <Buffers Value="64" />
    </SystemCollector>

    <SystemProvider Id="NxbStorageIOQueueSystemProvider">
      <Keywords>
        <Keyword Value="DiskIO" />
        <Keyword Value="DiskIOInitialization" />
        <Keyword Value="FileIO" />
        <Keyword Value="FileIOInit" />
        <Keyword Value="Filename" />
        <Keyword Value="Loader" />
        <Keyword Value="ProcessThread" />
        <Keyword Value="SplitIO" />
      </Keywords>
      <Stacks>
        <Stack Value="DiskFlushInit" />
        <Stack Value="DiskReadInit" />
        <Stack Value="DiskWriteInit" />
        <Stack Value="FileClose" />
        <Stack Value="FileCreate" />
        <Stack Value="FileDelete" />
        <Stack Value="FileFlush" />
        <Stack Value="FileRead" />
        <Stack Value="FileRename" />
        <Stack Value="FileWrite" />
        <Stack Value="SplitIO" />
      </Stacks>
    </SystemProvider>

    <Profile
      Id="NxbStorageIOQueue.Verbose.File"
      Name="NxbStorageIOQueue"
      DetailLevel="Verbose"
      LoggingMode="File"
      Description="Bounded disk, file-system and storage I/O analysis profile">
      <ProblemCategories>
        <ProblemCategory Value="First Level Triage" />
      </ProblemCategories>
      <Collectors>
        <SystemCollectorId Value="NxbStorageIOQueueSystemCollectorFile">
          <SystemProviderId Value="NxbStorageIOQueueSystemProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>

    <Profile
      Id="NxbStorageIOQueue.Verbose.Memory"
      Name="NxbStorageIOQueue"
      DetailLevel="Verbose"
      LoggingMode="Memory"
      Description="Disk, file-system and storage I/O analysis profile for memory capture">
      <ProblemCategories>
        <ProblemCategory Value="First Level Triage" />
      </ProblemCategories>
      <Collectors>
        <SystemCollectorId Value="NxbStorageIOQueueSystemCollectorMemory">
          <SystemProviderId Value="NxbStorageIOQueueSystemProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
