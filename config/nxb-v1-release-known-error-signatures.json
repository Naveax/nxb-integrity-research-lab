{
  "schema_version": 1,
  "contract_id": "nxb-v1-release-known-error-signatures-v1",
  "rules": [
    {
      "id": "NXB-ERR-036",
      "description": "Bare typed member expression passed in PowerShell command argument mode can be parsed as literal argument fragments instead of the intended cast/member expression.",
      "include": [
        "scripts/Invoke-NxbV1ReleaseIntegrationCertification.ps1",
        "scripts/Test-NxbV1ReleaseIntegration.ps1",
        "tests/V1ReleaseIntegration.Tests.ps1",
        "scripts/NxbV1ProductionSigning.Common.ps1",
        "scripts/Invoke-NxbV1ReleaseManifestSigning.ps1",
        "scripts/Invoke-NxbV1ProductionSigningCertification.ps1",
        "tests/V1ProductionSigning.Tests.ps1",
        "scripts/NxbV1Installer.Common.ps1",
        "scripts/NxbV1Installer.State.ps1",
        "scripts/Export-NxbV1PackageManifest.ps1",
        "scripts/Test-NxbV1InstallerHost.ps1",
        "scripts/Invoke-NxbV1Installer.ps1",
        "scripts/Invoke-NxbV1InstallerCertification.ps1",
        "tests/V1Installer.Tests.ps1",
        "scripts/NxbV1Update.Common.ps1",
        "scripts/NxbV1Update.State.ps1",
        "scripts/Invoke-NxbV1Updater.ps1",
        "scripts/Invoke-NxbV1UpdateCertification.ps1",
        "tests/V1Update.Tests.ps1",
        "scripts/NxbV1Cli.Common.ps1",
        "scripts/nxb.ps1",
        "scripts/Invoke-NxbV1CliKnownErrorScan.ps1",
        "scripts/Invoke-NxbV1CliCertification.ps1",
        "tests/V1Cli.Tests.ps1"
      ],
      "regex": "(?im)\\bJoin-Path\\s+\\$[A-Za-z_][A-Za-z0-9_]*\\s+\\[(?:string|int|long|int64|bool)\\]\\$[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*"
    }
  ]
}
