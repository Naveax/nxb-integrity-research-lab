{
  "schema_version": 1,
  "ledger_path": "docs/NXB-KNOWN-ERROR-LEDGER.md",
  "rules": [
    {
      "id": "NXB-ERR-001",
      "description": "Ambiguous non-scope PowerShell variable immediately followed by colon in a double-quoted string",
      "include_globs": [
        "scripts/*NxbAdaptive*.ps1",
        "scripts/*NxbSemantic*.ps1",
        "scripts/Invoke-NxbKnownErrorScan.ps1",
        "tests/Adaptive*.Tests.ps1",
        "tests/Semantic*.Tests.ps1",
        "tests/KnownErrorLedger.Tests.ps1"
      ],
      "regex": "(?m)\"[^\"\\r\\n]*\\$(?!(?:env|global|script|local|private|using):)[A-Za-z_][A-Za-z0-9_]*:[^\"\\r\\n]*\""
    },
    {
      "id": "NXB-ERR-002",
      "description": "Global Get-WinEvent provider enumeration with ErrorAction Stop",
      "include_globs": ["scripts/Get-NxbTransitionSurfaceDiscovery.ps1"],
      "regex": "(?im)Get-WinEvent\\s+-ListProvider\\s+\\*\\s+-ErrorAction\\s+Stop"
    },
    {
      "id": "NXB-ERR-005",
      "description": "Empty catch block",
      "include_globs": [
        "scripts/*NxbAdaptive*.ps1",
        "scripts/*NxbSemantic*.ps1",
        "scripts/Invoke-NxbKnownErrorScan.ps1",
        "tests/Adaptive*.Tests.ps1",
        "tests/Semantic*.Tests.ps1",
        "tests/KnownErrorLedger.Tests.ps1"
      ],
      "regex": "(?ims)catch\\s*\\{\\s*\\}"
    },
    {
      "id": "NXB-ERR-006",
      "description": "Assignment to PowerShell automatic Matches variable",
      "include_globs": [
        "scripts/*NxbAdaptive*.ps1",
        "scripts/*NxbSemantic*.ps1",
        "scripts/Invoke-NxbKnownErrorScan.ps1",
        "tests/Adaptive*.Tests.ps1",
        "tests/Semantic*.Tests.ps1",
        "tests/KnownErrorLedger.Tests.ps1"
      ],
      "regex": "(?im)^\\s*\\$matches\\s*="
    },
    {
      "id": "NXB-ERR-007",
      "description": "New-Nxb test/helper function likely to trigger ShouldProcess analyzer rule",
      "include_globs": ["tests/Adaptive*.Tests.ps1", "tests/Semantic*.Tests.ps1", "tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?im)^\\s*function\\s+New-Nxb[^\\r\\n]*(?:Test|Fixture|Plan)[A-Za-z0-9_-]*\\b"
    },
    {
      "id": "NXB-ERR-008",
      "description": "Known plural-noun helper declarations",
      "include_globs": ["scripts/*NxbAdaptive*.ps1", "scripts/*NxbSemantic*.ps1", "tests/Adaptive*.Tests.ps1", "tests/Semantic*.Tests.ps1"],
      "regex": "(?im)^\\s*function\\s+(?:Write-Nxb(?:HysteresisSignals|AdaptiveTestSignals)|Get-NxbStableUniqueDomains)\\b"
    },
    {
      "id": "NXB-ERR-011",
      "description": "Known fail-open unreadable trigger-state fallback",
      "include_globs": ["scripts/Update-NxbAdaptiveObservabilityState.ps1"],
      "regex": "(?is)catch\\s*\\{[^}]{0,400}(?:starting\\s+from\\s+empty\\s+state|previousState\\s*=\\s*\\$null)"
    },
    {
      "id": "NXB-ERR-014",
      "description": "Pester shared-path or expected-value assignment pattern that can trigger PSUseDeclaredVarsMoreThanAssignments across BeforeAll/It scopes",
      "include_globs": ["tests/Semantic*.Tests.ps1"],
      "regex": "(?im)^\\s*\\$(?:validatorPath|pythonValidatorPath|fixturePath|expectedHead|expectedPolicy|expectedMachine)\\s*="
    },
    {
      "id": "NXB-ERR-015",
      "description": "Double-quoted Regex.Escape expected-source literal containing a PowerShell variable",
      "include_globs": ["tests/Adaptive*.Tests.ps1", "tests/Semantic*.Tests.ps1", "tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?im)\\[regex\\]::Escape\\(\\s*\"[^\"\\r\\n]*\\$[A-Za-z_][A-Za-z0-9_]*[^\"\\r\\n]*\"\\s*\\)"
    },
    {
      "id": "NXB-ERR-019",
      "description": "Bare WildcardOptions engine enum type that is not a PowerShell type accelerator",
      "include_globs": ["scripts/Invoke-NxbKnownErrorScan.ps1"],
      "regex": "(?im)\\[WildcardOptions\\]::"
    },
    {
      "id": "NXB-ERR-021",
      "description": "Assignment to the automatic PROFILE variable through case-insensitive profile spelling",
      "include_globs": [
        "scripts/*NxbAdaptive*.ps1",
        "scripts/*NxbSemantic*.ps1",
        "tests/Adaptive*.Tests.ps1",
        "tests/Semantic*.Tests.ps1",
        "tests/KnownErrorLedger.Tests.ps1"
      ],
      "regex": "(?im)^\\s*\\$profile\\s*="
    },
    {
      "id": "NXB-ERR-022",
      "description": "Semantic Python expected-failure helper reaches native stderr merge before establishing a scoped ErrorAction guard",
      "include_globs": ["tests/Semantic*.Tests.ps1"],
      "regex": "(?ims)function\\s+Invoke-NxbSemanticPythonTest\\b(?:(?!\\$previousErrorActionPreference).){0,4000}\\$nativeOutput\\s*=\\s*@\\(&\\s+\\$pythonPath\\s+@argumentList\\s+2>&1\\)"
    }
  ]
}
