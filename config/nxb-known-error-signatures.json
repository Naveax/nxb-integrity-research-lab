{
  "schema_version": 1,
  "ledger_path": "docs/NXB-KNOWN-ERROR-LEDGER.md",
  "rules": [
    {
      "id": "NXB-ERR-001",
      "description": "Ambiguous non-scope PowerShell variable immediately followed by colon in a double-quoted string",
      "include_globs": ["scripts/*NxbAdaptive*.ps1","scripts/*NxbSemantic*.ps1","scripts/*NxbControllerTarget*.ps1","scripts/*NxbPart4*.ps1","scripts/*NxbPart5*.ps1","scripts/Invoke-NxbKnownErrorScan.ps1","tests/Adaptive*.Tests.ps1","tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1","tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?m)\"[^\"\\r\\n]*\\$(?!(?:env|global|script|local|private|using):)[A-Za-z_][A-Za-z0-9_]*:[^\"\\r\\n]*\""
    },
    {
      "id": "NXB-ERR-002",
      "description": "Global Get-WinEvent provider enumeration with ErrorAction Stop",
      "include_globs": ["scripts/Get-NxbTransitionSurfaceDiscovery.ps1"],
      "regex": "(?im)Get-WinEvent\\s+-ListProvider\\s+\\*\\s+-ErrorAction\\s+Stop"
    },
    {
      "id": "NXB-ERR-005",
      "description": "Empty catch block",
      "include_globs": ["scripts/*NxbAdaptive*.ps1","scripts/*NxbSemantic*.ps1","scripts/*NxbControllerTarget*.ps1","scripts/*NxbPart4*.ps1","scripts/*NxbPart5*.ps1","scripts/Invoke-NxbKnownErrorScan.ps1","tests/Adaptive*.Tests.ps1","tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1","tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?ims)catch\\s*\\{\\s*\\}"
    },
    {
      "id": "NXB-ERR-006",
      "description": "Assignment to PowerShell automatic Matches variable",
      "include_globs": ["scripts/*NxbAdaptive*.ps1","scripts/*NxbSemantic*.ps1","scripts/*NxbControllerTarget*.ps1","scripts/*NxbPart4*.ps1","scripts/*NxbPart5*.ps1","scripts/Invoke-NxbKnownErrorScan.ps1","tests/Adaptive*.Tests.ps1","tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1","tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?im)^\\s*\\$matches\\s*="
    },
    {
      "id": "NXB-ERR-007",
      "description": "New-Nxb test/helper function likely to trigger ShouldProcess analyzer rule",
      "include_globs": ["tests/Adaptive*.Tests.ps1","tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1","tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?im)^\\s*function\\s+New-Nxb[^\\r\\n]*(?:Test|Fixture|Plan)[A-Za-z0-9_-]*\\b"
    },
    {
      "id": "NXB-ERR-008",
      "description": "Known plural-noun helper declarations",
      "include_globs": ["scripts/*NxbAdaptive*.ps1","scripts/*NxbSemantic*.ps1","scripts/*NxbControllerTarget*.ps1","scripts/*NxbPart4*.ps1","scripts/*NxbPart5*.ps1","tests/Adaptive*.Tests.ps1","tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1"],
      "regex": "(?im)^\\s*function\\s+(?:Write-Nxb(?:HysteresisSignals|AdaptiveTestSignals)|Get-NxbStableUniqueDomains)\\b"
    },
    {
      "id": "NXB-ERR-011",
      "description": "Known fail-open unreadable trigger-state fallback",
      "include_globs": ["scripts/Update-NxbAdaptiveObservabilityState.ps1"],
      "regex": "(?is)catch\\s*\\{[^}]{0,400}(?:starting\\s+from\\s+empty\\s+state|previousState\\s*=\\s*\\$null)"
    },
    {
      "id": "NXB-ERR-014",
      "description": "Pester shared-path or expected-value assignment pattern that can trigger PSUseDeclaredVarsMoreThanAssignments across BeforeAll/It scopes",
      "include_globs": ["tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1"],
      "regex": "(?im)^\\s*\\$(?:validatorPath|pythonValidatorPath|fixturePath|expectedHead|expectedPolicy|expectedMachine)\\s*="
    },
    {
      "id": "NXB-ERR-015",
      "description": "Double-quoted Regex.Escape expected-source literal containing a PowerShell variable",
      "include_globs": ["tests/Adaptive*.Tests.ps1","tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1","tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?im)\\[regex\\]::Escape\\(\\s*\"[^\"\\r\\n]*\\$[A-Za-z_][A-Za-z0-9_]*[^\"\\r\\n]*\"\\s*\\)"
    },
    {
      "id": "NXB-ERR-019",
      "description": "Bare WildcardOptions engine enum type that is not a PowerShell type accelerator",
      "include_globs": ["scripts/Invoke-NxbKnownErrorScan.ps1"],
      "regex": "(?im)\\[WildcardOptions\\]::"
    },
    {
      "id": "NXB-ERR-021",
      "description": "Assignment to the automatic PROFILE variable through case-insensitive profile spelling",
      "include_globs": ["scripts/*NxbAdaptive*.ps1","scripts/*NxbSemantic*.ps1","scripts/*NxbControllerTarget*.ps1","scripts/*NxbPart4*.ps1","scripts/*NxbPart5*.ps1","tests/Adaptive*.Tests.ps1","tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1","tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?im)^\\s*\\$profile\\s*="
    },
    {
      "id": "NXB-ERR-022",
      "description": "Native stderr merge under inherited Stop preference without a scoped ErrorAction guard",
      "include_globs": ["tests/Semantic*.Tests.ps1","scripts/Invoke-NxbSemanticPowerFirmwareExperiment.ps1","scripts/Invoke-NxbControllerTargetTransportCertification.ps1","scripts/Invoke-NxbPart4ResumableRunnerExperiment.ps1","scripts/Invoke-NxbPart4ResumableRunnerCertification.ps1","scripts/Invoke-NxbPart5SignedClosureCertification.ps1"],
      "regex": "(?ims)(?:function\\s+Invoke-NxbSemanticPythonTest\\b(?:(?!\\$previousErrorActionPreference).){0,4000}\\$nativeOutput\\s*=\\s*@\\(&\\s+\\$pythonPath\\s+@argumentList\\s+2>&1\\)|\\$[A-Za-z_][A-Za-z0-9_]*\\s*=\\s*@\\(&\\s+\\$PowerCfgPath\\b[^\\r\\n]*2>&1\\)|function\\s+Invoke-NxbTransportCertificationNative\\b(?:(?!\\$previousErrorActionPreference).){0,4000}\\$nativeOutput\\s*=\\s*@\\(&\\s+\\$Executable\\s+@ArgumentList\\s+2>&1\\)|function\\s+Invoke-NxbPart4WorkerProcess\\b(?:(?!\\$previous\\s*=\\s*\\$ErrorActionPreference).){0,5000}\\$output\\s*=\\s*@\\(&\\s+\\$PwshPath\\s+@arguments\\s+2>&1\\)|function\\s+Invoke-NxbPart4CertificationNative\\b(?:(?!\\$previousErrorActionPreference).){0,5000}\\$nativeOutput\\s*=\\s*@\\(&\\s+\\$Executable\\s+@ArgumentList\\s+2>&1\\)|function\\s+Invoke-NxbPart5CertificationNative\\b(?:(?!\\$previousErrorActionPreference).){0,5000}\\$nativeOutput\\s*=\\s*@\\(&\\s+\\$Executable\\s+@ArgumentList\\s+2>&1\\))"
    },
    {
      "id": "NXB-ERR-024",
      "description": "Treating a JSON array as PSObject.Properties instead of enumerating its elements",
      "include_globs": ["scripts/*NxbSemantic*.ps1","scripts/*NxbControllerTarget*.ps1","scripts/*NxbPart4*.ps1","scripts/*NxbPart5*.ps1","tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1","tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?im)\\.claim_targets\\.PSObject\\.Properties\\b"
    },
    {
      "id": "NXB-ERR-025",
      "description": "Shallow native capability preflight based on DLL/provider presence or unsupported CIM PnP enumeration",
      "include_globs": ["scripts/Test-NxbSemanticHardeningHostCapability.ps1","scripts/Invoke-NxbSemanticPnpEventExperiment.ps1"],
      "regex": "(?im)(?:Get-CimInstance\\s+Win32_PnPEntity\\b|\\$softwareDeviceApiAvailable\\s*=\\s*\\(Test-Path\\s+-LiteralPath\\s+\\$softwareDeviceDll\\b)"
    },
    {
      "id": "NXB-ERR-026",
      "description": "Non-ASCII character in active IRL-006 PowerShell authority or test source",
      "include_globs": ["scripts/*NxbSemantic*.ps1","scripts/*NxbControllerTarget*.ps1","scripts/*NxbPart4*.ps1","scripts/*NxbPart5*.ps1","tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1","tests/KnownErrorLedger.Tests.ps1"],
      "regex": "[^\\u0000-\\u007F]"
    },
    {
      "id": "NXB-ERR-027",
      "description": "Optional Windows diagnostic EventLog used as mandatory PnP semantic evidence authority",
      "include_globs": ["scripts/Invoke-NxbSemanticPnpEventExperiment.ps1"],
      "regex": "(?im)\\bGet-WinEvent\\b"
    },
    {
      "id": "NXB-ERR-028",
      "description": "Fragile text-regex ASCII source assertion that can false-positive in the Windows PowerShell 5.1 Pester path",
      "include_globs": ["tests/Semantic*.Tests.ps1","tests/ControllerTarget*.Tests.ps1","tests/Part4*.Tests.ps1","tests/Part5*.Tests.ps1","tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?im)Should\\s+-Not\\s+-Match\\s+['\"]\\[\\^\\\\u0000-\\\\u007F\\]['\"]"
    },
    {
      "id": "NXB-ERR-029",
      "description": "Brittle ledger contract assertion coupled to exact prose instead of stable IDs and behavior",
      "include_globs": ["tests/KnownErrorLedger.Tests.ps1"],
      "regex": "(?im)\\$ledger\\s*\\|\\s*Should\\s+-Match\\s+\\(\\[regex\\]::Escape\\(\\s*['\"][A-Za-z][^'\"\\r\\n]{24,}['\"]\\s*\\)\\s*\\)"
    },
    {
      "id": "NXB-ERR-030",
      "description": "Mandatory object-array parameter rejects an expected empty PnP evidence collection",
      "include_globs": ["scripts/Invoke-NxbSemanticPnpEventExperiment.ps1"],
      "regex": "(?im)\\[Parameter\\(Mandatory\\)\\]\\[object\\[\\]\\]\\$Record\\b"
    },
    {
      "id": "NXB-ERR-031",
      "description": "Direct Hyper-V VMFirmware EnableSecureBoot readback assumes a property name that can vary by host module object shape",
      "include_globs": ["scripts/Invoke-NxbSemanticPowerFirmwareExperiment.ps1"],
      "regex": "(?im)\\(\\s*Get-VMFirmware\\b[^\\r\\n]*\\)\\.EnableSecureBoot\\b"
    },
    {
      "id": "NXB-ERR-032",
      "description": "Nested ordered dictionary evidence is traversed only through PSObject.Properties, causing valid dictionary keys to fall through to sentinel defaults",
      "include_globs": ["scripts/Invoke-NxbSemanticRootTraceExperiment.ps1"],
      "regex": "(?ims)foreach\\s*\\(\\$segment\\s+in\\s+\\$Path\\.Split\\('\\.'\\)\\)\\s*\\{\\s*if\\s*\\(\\$null\\s+-eq\\s+\\$current\\)\\s*\\{\\s*return\\s+\\$DefaultValue\\s*\\}\\s*\\$property\\s*=\\s*\\$current\\.PSObject\\.Properties\\[\\$segment\\]"
    }
  ]
}
