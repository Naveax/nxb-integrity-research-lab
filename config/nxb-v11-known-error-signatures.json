{"authority":"nxb-v11-known-error-signatures-v1","rules":[{"applies_to":["executable_powershell","pester_test"],"description":"PowerShell authority/test source must not contain an empty catch block.","failure_override_permitted":false,"flags":["IGNORECASE","MULTILINE","DOTALL"],"id":"NXB-V11-ERR-001","regex":"catch\\s*\\{\\s*\\}","severity":"error"},{"applies_to":["executable_powershell","pester_test"],"description":"PowerShell authority/test source must not assign to the automatic Matches variable.","failure_override_permitted":false,"flags":["IGNORECASE","MULTILINE"],"id":"NXB-V11-ERR-002","regex":"^\\s*\\$matches\\s*=","severity":"error"},{"applies_to":["executable_powershell","pester_test"],"description":"PowerShell double-quoted strings must not use an ambiguous unscoped variable immediately followed by colon.","failure_override_permitted":false,"flags":["MULTILINE"],"id":"NXB-V11-ERR-003","regex":"\\\"[^\\\"\\r\\n]*\\$(?!(?:env|global|script|local|private|using):)[A-Za-z_][A-Za-z0-9_]*:[^\\\"\\r\\n]*\\\"","severity":"error"},{"applies_to":["workflow_orchestration"],"description":"Successor workflow authority must never use pull_request_target.","failure_override_permitted":false,"flags":["IGNORECASE","MULTILINE"],"id":"NXB-V11-ERR-004","regex":"^\\s*pull_request_target\\s*:","severity":"error"},{"applies_to":["workflow_orchestration"],"description":"Third-party GitHub Actions refs must be pinned to a full lowercase 40-hex commit.","failure_override_permitted":false,"flags":["MULTILINE"],"id":"NXB-V11-ERR-005","regex":"^\\s*-?\\s*uses\\s*:\\s*[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@(?![0-9a-f]{40}(?:\\s*(?:#.*)?)?$)[^\\r\\n]+$","severity":"error"},{"applies_to":["executable_python"],"description":"Successor Python judging tools must not use eval or exec on dynamic source.","failure_override_permitted":false,"flags":["MULTILINE"],"id":"NXB-V11-ERR-006","regex":"\\b(?:eval|exec)\\s*\\(","severity":"error"}],"schema_version":1}