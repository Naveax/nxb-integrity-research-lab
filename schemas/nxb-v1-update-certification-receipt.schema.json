{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxb.local/schemas/nxb-v1-update-certification-receipt.schema.json",
  "title": "NXB v1 Update Certification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","status","authority","update_head","predecessor_installer_head","production_signing_head","release_integration_head","certified_implementation_head","ps7","ps51","independent_requirements","independent_negative_controls","base_known_error_rules","production_extension_rules","release_known_error_rules","signing_known_error_rules","installer_known_error_rules","update_known_error_rules","known_error_findings","analyzer_findings","trust_anchor_passed","stage_passed","apply_passed","failure_rollback_passed","manual_rollback_passed","auto_apply_performed","machine_install_performed","production_release_updated","lifecycle_sha256","created_utc"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "authority": {"const": "nxb-v1-update-certification-v1"},
    "update_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "predecessor_installer_head": {"const": "efdeb275c25a7df1326d7effdddb4af8d83ef81d"},
    "production_signing_head": {"const": "91be58af59d0703de0159fea9d11935805e16022"},
    "release_integration_head": {"const": "9371399bab4fbb921ad94198aa148c597c7b6261"},
    "certified_implementation_head": {"const": "a10535b294c4d7ba8a4c3683154609087bf50c4b"},
    "ps7": {"const": "24/24"},
    "ps51": {"const": "24/24"},
    "independent_requirements": {"const": 16},
    "independent_negative_controls": {"const": 12},
    "base_known_error_rules": {"type": "integer", "minimum": 23},
    "production_extension_rules": {"const": 9},
    "release_known_error_rules": {"const": 1},
    "signing_known_error_rules": {"const": 2},
    "installer_known_error_rules": {"const": 4},
    "update_known_error_rules": {"const": 6},
    "known_error_findings": {"const": 0},
    "analyzer_findings": {"const": 0},
    "trust_anchor_passed": {"const": true},
    "stage_passed": {"const": true},
    "apply_passed": {"const": true},
    "failure_rollback_passed": {"const": true},
    "manual_rollback_passed": {"const": true},
    "auto_apply_performed": {"const": false},
    "machine_install_performed": {"const": false},
    "production_release_updated": {"const": false},
    "lifecycle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_utc": {"type": "string", "minLength": 1}
  }
}
