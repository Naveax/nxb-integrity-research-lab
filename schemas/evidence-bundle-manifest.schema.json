{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxb.local/schemas/evidence-bundle-manifest.schema.json",
  "title": "NXB Evidence Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "machine_id",
    "boot_id",
    "session_id",
    "chain_sha256",
    "records",
    "files",
    "signature_state",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "machine_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "boot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "chain_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "relative_path",
          "length",
          "sha256"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "relative_path": {
            "$ref": "#/$defs/relative_path"
          },
          "length": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "length",
          "sha256"
        ],
        "properties": {
          "relative_path": {
            "$ref": "#/$defs/relative_path"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "signature_state": {
      "type": "string",
      "enum": [
        "unsigned",
        "present_unverified",
        "valid"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "relative_path"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "bundle_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "signature_state": {
            "const": "unsigned"
          }
        },
        "required": ["signature_state"]
      },
      "then": {
        "not": {
          "required": ["signature"]
        }
      },
      "else": {
        "required": ["signature"]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[^\\\\]+$"
    }
  }
}
