{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxb.local/schemas/nxb-v1-package-manifest.schema.json",
  "title": "NXB v1 Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","contract_id","release_version","source_head","created_utc","file_count","total_bytes","files"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "nxb-v1-package-manifest-v1"},
    "release_version": {"enum": ["1.0.0", "1.0.1"]},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_utc": {"type": "string", "minLength": 1},
    "file_count": {"type": "integer", "minimum": 1, "maximum": 2048},
    "total_bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path","bytes","sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[|\\r\\n\\\\]).+$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
