{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxb.local/schemas/nxb-v1-installer-certification-receipt.schema.json",
  "title": "NXB v1 Installer Certification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","status","authority","installer_head","predecessor_production_signing_head","release_integration_head","certified_implementation_head","ps7","ps51","independent_requirements","independent_negative_controls","base_known_error_rules","production_extension_rules","release_known_error_rules","signing_known_error_rules","installer_known_error_rules","known_error_findings","analyzer_findings","host_preflight_passed","portable_stage_passed","per_user_install_passed","corruption_detected","repair_passed","uninstall_passed","machine_install_performed","production_release_installed","package_manifest_sha256","lifecycle_sha256","created_utc"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "authority": {"const": "nxb-v1-installer-certification-v1"},
    "installer_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "predecessor_production_signing_head": {"const": "91be58af59d0703de0159fea9d11935805e16022"},
    "release_integration_head": {"const": "9371399bab4fbb921ad94198aa148c597c7b6261"},
    "certified_implementation_head": {"const": "a10535b294c4d7ba8a4c3683154609087bf50c4b"},
    "ps7": {"const": "22/22"},
    "ps51": {"const": "22/22"},
    "independent_requirements": {"const": 14},
    "independent_negative_controls": {"const": 10},
    "base_known_error_rules": {"type": "integer", "minimum": 23},
    "production_extension_rules": {"const": 9},
    "release_known_error_rules": {"const": 1},
    "signing_known_error_rules": {"const": 2},
    "installer_known_error_rules": {"const": 4},
    "known_error_findings": {"const": 0},
    "analyzer_findings": {"const": 0},
    "host_preflight_passed": {"const": true},
    "portable_stage_passed": {"const": true},
    "per_user_install_passed": {"const": true},
    "corruption_detected": {"const": true},
    "repair_passed": {"const": true},
    "uninstall_passed": {"const": true},
    "machine_install_performed": {"const": false},
    "production_release_installed": {"const": false},
    "package_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_utc": {"type": "string", "minLength": 1}
  }
}
