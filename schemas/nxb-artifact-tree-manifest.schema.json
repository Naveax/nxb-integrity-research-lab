{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nxb:schema:nxb-artifact-tree-manifest:v1",
  "title": "NXB V11 Artifact Tree Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "root_role",
    "file_count",
    "total_bytes",
    "files"
  ],
  "properties": {
    "contract_id": {
      "const": "nxb-artifact-tree-manifest-v1"
    },
    "root_role": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "byte_length",
          "sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}