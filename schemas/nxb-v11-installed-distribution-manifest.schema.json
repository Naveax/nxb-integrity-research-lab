{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nxb:schema:nxb-v11-installed-distribution-manifest:v1",
  "title":"NXB V11 installed distribution manifest v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "authority","python_dependency_lock_sha256","wheelhouse_manifest_sha256",
    "python_full_version","pip_version","distribution_count","file_count",
    "total_bytes","distributions"
  ],
  "properties":{
    "authority":{"const":"nxb-v11-installed-distribution-manifest-v1"},
    "python_dependency_lock_sha256":{"$ref":"#/$defs/sha256"},
    "wheelhouse_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "python_full_version":{"$ref":"#/$defs/version"},
    "pip_version":{"$ref":"#/$defs/version"},
    "distribution_count":{"type":"integer","minimum":0},
    "file_count":{"type":"integer","minimum":0},
    "total_bytes":{"type":"integer","minimum":0},
    "distributions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/distribution"}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "version":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._+!-]*$"},
    "normalizedName":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "wheelFilename":{"type":"string","minLength":5,"maxLength":512,"pattern":"^[A-Za-z0-9][A-Za-z0-9._+-]*\\.whl$"},
    "relativePath":{"type":"string","minLength":1,"maxLength":2048,"pattern":"^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f:])[^/]+(?:/[^/]+)*$"},
    "file":{
      "type":"object",
      "additionalProperties":false,
      "required":["relative_path","byte_length","sha256"],
      "properties":{
        "relative_path":{"$ref":"#/$defs/relativePath"},
        "byte_length":{"type":"integer","minimum":0},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "distribution":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "normalized_name","version","source_wheel_filename","source_wheel_sha256",
        "source_extracted_tree_sha256","metadata_relative_path","metadata_sha256",
        "record_relative_path","record_sha256","files"
      ],
      "properties":{
        "normalized_name":{"$ref":"#/$defs/normalizedName"},
        "version":{"$ref":"#/$defs/version"},
        "source_wheel_filename":{"$ref":"#/$defs/wheelFilename"},
        "source_wheel_sha256":{"$ref":"#/$defs/sha256"},
        "source_extracted_tree_sha256":{"$ref":"#/$defs/sha256"},
        "metadata_relative_path":{"$ref":"#/$defs/relativePath"},
        "metadata_sha256":{"$ref":"#/$defs/sha256"},
        "record_relative_path":{"$ref":"#/$defs/relativePath"},
        "record_sha256":{"$ref":"#/$defs/sha256"},
        "files":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/file"}}
      }
    }
  }
}