{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nxb:schema:nxb-v11-known-error-signatures:v1",
  "title": "NXB V11 known-error signatures v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority", "schema_version", "rules"],
  "properties": {
    "authority": {"const": "nxb-v11-known-error-signatures-v1"},
    "schema_version": {"const": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "ruleId": {
      "type": "string",
      "pattern": "^NXB-V11-ERR-[0-9]{3}$"
    },
    "validationClass": {
      "enum": [
        "workflow_orchestration",
        "executable_powershell",
        "executable_python",
        "pester_test",
        "strict_json_policy_or_schema",
        "locked_dependency_manifest",
        "logical_fixture_spec",
        "authority_documentation"
      ]
    },
    "regexFlag": {
      "enum": ["IGNORECASE", "MULTILINE", "DOTALL"]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "applies_to",
        "regex",
        "flags",
        "severity",
        "failure_override_permitted"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "description": {"type": "string", "minLength": 1, "maxLength": 512},
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/validationClass"}
        },
        "regex": {"type": "string", "minLength": 1, "maxLength": 8192},
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/regexFlag"}
        },
        "severity": {"const": "error"},
        "failure_override_permitted": {"const": false}
      }
    }
  }
}