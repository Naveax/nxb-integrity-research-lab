{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nxb:schema:nxb-v11-endurance-cycle-summary:v1",
  "title": "NXB V11 endurance-cycle summary v1",
  "description": "Claim-free structural limits for bounded 1h/6h/24h Part-3/Part-4/observability evidence. Schema-valid synthetic or recorded data does not establish policy, receipt or physical admission; independent external validation must check Git lineage, per-cycle equality, ordinal identity, timestamps, raw evidence and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "candidate",
    "cell_id",
    "cycle_count",
    "cycles",
    "endurance_tier",
    "fingerprint_sha256",
    "intent_sha256",
    "physical_compatibility_claimed",
    "policy_sha256",
    "production_boundary",
    "raw_payloads_embedded",
    "repository",
    "review",
    "schema_version",
    "status",
    "support_class"
  ],
  "properties": {
    "authority": {
      "const": "nxb-v11-endurance-cycle-summary-v1"
    },
    "schema_version": {
      "const": 1
    },
    "repository": {
      "const": "Naveax/nxb-integrity-research-lab"
    },
    "status": {
      "enum": [
        "synthetic_closed_unadmitted",
        "recorded_closed_unadmitted"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "tree_sha"
      ],
      "properties": {
        "sha": {
          "$ref": "#/$defs/git40"
        },
        "tree_sha": {
          "$ref": "#/$defs/git40"
        }
      }
    },
    "cell_id": {
      "$ref": "#/$defs/cellId"
    },
    "support_class": {
      "enum": [
        "primary",
        "retained",
        "previous-lts",
        "legacy-esu",
        "separate-hardware-class",
        "replay-only"
      ]
    },
    "endurance_tier": {
      "enum": [
        "1h",
        "6h",
        "24h"
      ]
    },
    "cycle_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "fingerprint_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "intent_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cycles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/cycle"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_count"
      ],
      "properties": {
        "entry_count": {
          "const": 6
        }
      }
    },
    "production_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge_mutation",
        "private_key_used",
        "release_mutation",
        "repository_protection_mutated",
        "tag_mutation"
      ],
      "properties": {
        "private_key_used": {
          "const": false
        },
        "tag_mutation": {
          "const": false
        },
        "release_mutation": {
          "const": false
        },
        "merge_mutation": {
          "const": false
        },
        "repository_protection_mutated": {
          "const": false
        }
      }
    },
    "raw_payloads_embedded": {
      "const": false
    },
    "physical_compatibility_claimed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "endurance_tier": {
            "const": "1h"
          }
        },
        "required": [
          "endurance_tier"
        ]
      },
      "then": {
        "properties": {
          "cycle_count": {
            "const": 1
          },
          "cycles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "endurance_tier": {
            "const": "6h"
          }
        },
        "required": [
          "endurance_tier"
        ]
      },
      "then": {
        "properties": {
          "cycle_count": {
            "const": 6
          },
          "cycles": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "endurance_tier": {
            "const": "24h"
          }
        },
        "required": [
          "endurance_tier"
        ]
      },
      "then": {
        "properties": {
          "cycle_count": {
            "const": 24
          },
          "cycles": {
            "type": "array",
            "minItems": 24,
            "maxItems": 24
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cellId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_sha",
        "candidate_tree_sha",
        "cell_id",
        "elapsed_seconds",
        "fingerprint_after_sha256",
        "fingerprint_before_sha256",
        "finished_utc",
        "index",
        "observability",
        "part3",
        "part4",
        "raw_evidence_sha256",
        "started_utc"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "elapsed_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "started_utc": {
          "$ref": "#/$defs/utc"
        },
        "finished_utc": {
          "$ref": "#/$defs/utc"
        },
        "candidate_sha": {
          "$ref": "#/$defs/git40"
        },
        "candidate_tree_sha": {
          "$ref": "#/$defs/git40"
        },
        "cell_id": {
          "$ref": "#/$defs/cellId"
        },
        "fingerprint_before_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fingerprint_after_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "part4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "crash_detected",
            "emergency_recovery_closed",
            "final_resume_closed",
            "graceful_recovery_closed",
            "max_attempts_observed",
            "max_ticks_observed",
            "ready_queue_peak",
            "task_count",
            "tasks_completed"
          ],
          "properties": {
            "task_count": {
              "const": 24
            },
            "tasks_completed": {
              "const": 24
            },
            "max_ticks_observed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "max_attempts_observed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "ready_queue_peak": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "crash_detected": {
              "const": true
            },
            "graceful_recovery_closed": {
              "const": true
            },
            "emergency_recovery_closed": {
              "const": true
            },
            "final_resume_closed": {
              "const": true
            }
          }
        },
        "part3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accounting_closed",
            "high_watermark",
            "low_watermark",
            "max_frame_bytes_observed",
            "max_queue_depth_observed",
            "max_session_seconds_observed",
            "queue_overflow",
            "reconnect_attempts",
            "spool_byte_peak",
            "spool_record_peak",
            "synthetic_event_count"
          ],
          "properties": {
            "synthetic_event_count": {
              "const": 24
            },
            "max_frame_bytes_observed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "max_session_seconds_observed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "max_queue_depth_observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "high_watermark": {
              "const": 6
            },
            "low_watermark": {
              "const": 2
            },
            "spool_record_peak": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "spool_byte_peak": {
              "type": "integer",
              "minimum": 0,
              "maximum": 262144
            },
            "reconnect_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "queue_overflow": {
              "const": 0
            },
            "accounting_closed": {
              "const": true
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disk_bytes",
            "memory_wpr_trigger_count",
            "trace_accounting_closed",
            "trace_lost_events",
            "trace_post_seconds",
            "trace_pre_seconds",
            "trace_ring_bytes",
            "trace_session_seconds"
          ],
          "properties": {
            "memory_wpr_trigger_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "trace_ring_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "trace_pre_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "trace_post_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "trace_session_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "disk_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870912
            },
            "trace_lost_events": {
              "const": 0
            },
            "trace_accounting_closed": {
              "const": true
            }
          }
        },
        "raw_evidence_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observability",
            "part3",
            "part4",
            "recovery"
          ],
          "properties": {
            "part3": {
              "$ref": "#/$defs/sha256"
            },
            "part4": {
              "$ref": "#/$defs/sha256"
            },
            "observability": {
              "$ref": "#/$defs/sha256"
            },
            "recovery": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
