{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxb.local/schemas/nxb-v1-production-signing-certification-receipt.schema.json",
  "title": "NXB v1 Production Signing Certification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority",
    "release_head",
    "certified_implementation_head",
    "release_integration_predecessor_head",
    "ps7",
    "ps51",
    "independent_requirements",
    "independent_negative_controls",
    "base_known_error_rules",
    "production_extension_rules",
    "release_known_error_rules",
    "known_error_findings",
    "analyzer_findings",
    "signing_algorithm",
    "key_size_bits",
    "public_fingerprint",
    "envelope_sha256",
    "independent_validation_sha256",
    "certification_private_key_persisted",
    "production_signer_claimed",
    "actual_production_release_signed",
    "production_signing_pipeline_certified",
    "created_utc"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "authority": {"const": "nxb-v1-production-signing-certification-v1"},
    "release_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "certified_implementation_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_integration_predecessor_head": {"const": "9371399bab4fbb921ad94198aa148c597c7b6261"},
    "ps7": {"const": "18/18"},
    "ps51": {"const": "18/18"},
    "independent_requirements": {"const": 12},
    "independent_negative_controls": {"const": 8},
    "base_known_error_rules": {"type": "integer", "minimum": 23},
    "production_extension_rules": {"const": 9},
    "release_known_error_rules": {"type": "integer", "minimum": 1},
    "known_error_findings": {"const": 0},
    "analyzer_findings": {"const": 0},
    "signing_algorithm": {"const": "RSA-PKCS1-SHA256"},
    "key_size_bits": {"type": "integer", "minimum": 3072},
    "public_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "independent_validation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "certification_private_key_persisted": {"const": false},
    "production_signer_claimed": {"const": false},
    "actual_production_release_signed": {"const": false},
    "production_signing_pipeline_certified": {"const": true},
    "created_utc": {"type": "string", "minLength": 1}
  }
}
