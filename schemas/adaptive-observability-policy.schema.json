{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxb.local/schemas/adaptive-observability-policy.schema.json",
  "title": "NXB Adaptive Observability Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "default_level",
    "levels",
    "budgets",
    "retention",
    "domains",
    "rules"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "default_level": { "enum": ["off", "baseline", "focused", "forensic"] },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["off", "baseline", "focused", "forensic"],
      "properties": {
        "off": { "$ref": "#/$defs/level" },
        "baseline": { "$ref": "#/$defs/level" },
        "focused": { "$ref": "#/$defs/level" },
        "forensic": { "$ref": "#/$defs/level" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrent_elevated_domains", "max_capture_seconds", "cooldown_seconds", "max_review_bytes"],
      "properties": {
        "max_concurrent_elevated_domains": { "type": "integer", "minimum": 1, "maximum": 16 },
        "max_capture_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "cooldown_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "max_review_bytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["always_keep", "raw_payload_default", "hash_raw_identifiers", "redact_messages_by_default"],
      "properties": {
        "always_keep": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "raw_payload_default": { "type": "boolean" },
        "hash_raw_identifiers": { "type": "boolean" },
        "redact_messages_by_default": { "type": "boolean" }
      }
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/domain" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "description", "raw_payload_allowed"],
      "properties": {
        "rank": { "type": "integer", "minimum": 0, "maximum": 3 },
        "description": { "type": "string", "minLength": 1 },
        "raw_payload_allowed": { "type": "boolean" }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minimum_level", "maximum_level", "priority"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minimum_level": { "enum": ["off", "baseline", "focused", "forensic"] },
        "maximum_level": { "enum": ["off", "baseline", "focused", "forensic"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "signal", "domains", "level", "ttl_seconds", "priority"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signal": { "type": "string", "minLength": 1, "maxLength": 128 },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "level": { "enum": ["off", "baseline", "focused", "forensic"] },
        "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    }
  }
}
