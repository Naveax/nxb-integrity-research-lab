{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nxb:schema:nxb-v11-predecessor-replay-receipt:v1",
  "title": "NXB V11 predecessor replay wrapper receipt v1",
  "description": "Strict successor wrapper around the exact six frozen predecessor evidence files. The wrapper is the seventh entry and does not self-claim either its own digest or the final outer ZIP digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "schema_version",
    "status",
    "repository",
    "predecessor_main_sha",
    "predecessor_tree_sha",
    "observer_successor_head_sha",
    "run_id",
    "run_attempt",
    "artifact_name",
    "predecessor_policy_sha256",
    "predecessor_source_semantics",
    "replay_environment_acquisition",
    "historical_environment_byte_identity_claimed",
    "python_version",
    "python_executable_sha256",
    "powershell_host_version",
    "powershell_host_executable_sha256",
    "pester_version",
    "pester_package_sha256",
    "psscriptanalyzer_version",
    "psscriptanalyzer_package_sha256",
    "windows_powershell_version",
    "windows_powershell_executable_sha256",
    "hosted_ci_receipt_sha256",
    "known_error_scan_sha256",
    "pester_ps51_xml_sha256",
    "pester_ps7_xml_sha256",
    "ps51_summary_sha256",
    "run_ps51_sha256",
    "entry_count",
    "predecessor_worktree_clean_after_replay",
    "predecessor_head_preserved",
    "predecessor_tree_preserved",
    "pester_expected_partition_reproduced",
    "known_error_findings",
    "analyzer_findings",
    "production_boundary"
  ],
  "properties": {
    "authority": {
      "const": "nxb-v11-predecessor-replay-v1"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "passed"
    },
    "repository": {
      "const": "Naveax/nxb-integrity-research-lab"
    },
    "predecessor_main_sha": {
      "$ref": "#/$defs/git40"
    },
    "predecessor_tree_sha": {
      "$ref": "#/$defs/git40"
    },
    "observer_successor_head_sha": {
      "$ref": "#/$defs/git40"
    },
    "run_id": {
      "type": "integer",
      "minimum": 1
    },
    "run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_name": {
      "type": "string",
      "maxLength": 220,
      "pattern": "^nxb-v11-predecessor-replay-v1-[0-9a-f]{40}-[0-9a-f]{40}-[1-9][0-9]*-[1-9][0-9]*$"
    },
    "predecessor_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "predecessor_source_semantics": {
      "const": "frozen-v1"
    },
    "replay_environment_acquisition": {
      "const": "successor-locked"
    },
    "historical_environment_byte_identity_claimed": {
      "const": false
    },
    "python_version": {
      "const": "3.12.10"
    },
    "python_executable_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "powershell_host_version": {
      "type": "string",
      "pattern": "^7\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "powershell_host_executable_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "pester_version": {
      "const": "5.7.1"
    },
    "pester_package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "psscriptanalyzer_version": {
      "const": "1.25.0"
    },
    "psscriptanalyzer_package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "windows_powershell_version": {
      "type": "string",
      "pattern": "^5\\.1(?:\\.[0-9]+){2,3}$",
      "maxLength": 64
    },
    "windows_powershell_executable_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "hosted_ci_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "known_error_scan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "pester_ps51_xml_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "pester_ps7_xml_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ps51_summary_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_ps51_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "entry_count": {
      "const": 7
    },
    "predecessor_worktree_clean_after_replay": {
      "const": true
    },
    "predecessor_head_preserved": {
      "const": true
    },
    "predecessor_tree_preserved": {
      "const": true
    },
    "pester_expected_partition_reproduced": {
      "const": true
    },
    "known_error_findings": {
      "const": 0
    },
    "analyzer_findings": {
      "const": 0
    },
    "production_boundary": {
      "$ref": "#/$defs/productionBoundary"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "productionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_key_used",
        "signer_used",
        "tag_mutation",
        "release_mutation",
        "merge_mutation",
        "repository_protection_mutated"
      ],
      "properties": {
        "private_key_used": {
          "const": false
        },
        "signer_used": {
          "const": false
        },
        "tag_mutation": {
          "const": false
        },
        "release_mutation": {
          "const": false
        },
        "merge_mutation": {
          "const": false
        },
        "repository_protection_mutated": {
          "const": false
        }
      }
    }
  }
}
