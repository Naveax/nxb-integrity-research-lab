    "update_known_error_rules": {"const": 7},
    "cli_known_error_rules": {"const": 5},
    "known_error_findings": {"const": 0},
    "analyzer_findings": {"const": 0},
    "legacy_commands_preserved": {"const": true},
    "signed_update_delegation": {"const": true},
    "stable_json_output": {"const": true},
    "stable_exit_codes": {"const": true},
    "explicit_mutation_confirmation": {"const": true},
    "dry_run_supported": {"const": true},
    "auto_apply": {"const": false},
    "production_release_updated": {"const": false},
