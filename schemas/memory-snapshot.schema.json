{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxb.local/schemas/memory-snapshot.schema.json",
  "title": "NXB Memory Snapshot Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "experiment_id",
    "experiment_relative_path",
    "machine_id",
    "boot_id",
    "captured_utc",
    "target",
    "system",
    "processes",
    "summary",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "snapshot_id": {
      "$ref": "#/$defs/identifier"
    },
    "experiment_id": {
      "$ref": "#/$defs/identifier"
    },
    "experiment_relative_path": {
      "$ref": "#/$defs/experimentRelativePath"
    },
    "machine_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "boot_id": {
      "$ref": "#/$defs/lowerSha256"
    },
    "captured_utc": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "system": {
      "$ref": "#/$defs/system"
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/process"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "claims": {
      "$ref": "#/$defs/claims"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "experimentRelativePath": {
      "type": "string",
      "pattern": "^experiments/[A-Za-z0-9._-]+$"
    },
    "lowerSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "collector",
        "kind",
        "provenance_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "collector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "native_api",
            "cim_snapshot",
            "process_snapshot",
            "performance_counter",
            "etw_summary",
            "synthetic_fixture"
          ]
        },
        "provenance_sha256": {
          "$ref": "#/$defs/lowerSha256"
        }
      }
    },
    "measuredByte": {
      "type": "object",
      "required": [
        "status",
        "value",
        "unit",
        "source",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "measured"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "bytes"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "type": "null"
        }
      }
    },
    "unmeasuredByte": {
      "type": "object",
      "required": [
        "status",
        "value",
        "unit",
        "source",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "unsupported",
            "unavailable",
            "failed",
            "not_assessed"
          ]
        },
        "value": {
          "type": "null"
        },
        "unit": {
          "const": "bytes"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "byteMeasurement": {
      "oneOf": [
        {
          "$ref": "#/$defs/measuredByte"
        },
        {
          "$ref": "#/$defs/unmeasuredByte"
        }
      ]
    },
    "measuredCount": {
      "type": "object",
      "required": [
        "status",
        "value",
        "unit",
        "source",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "measured"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "count"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "type": "null"
        }
      }
    },
    "unmeasuredCount": {
      "type": "object",
      "required": [
        "status",
        "value",
        "unit",
        "source",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "unsupported",
            "unavailable",
            "failed",
            "not_assessed"
          ]
        },
        "value": {
          "type": "null"
        },
        "unit": {
          "const": "count"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "countMeasurement": {
      "oneOf": [
        {
          "$ref": "#/$defs/measuredCount"
        },
        {
          "$ref": "#/$defs/unmeasuredCount"
        }
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "process_id",
        "process_start_utc",
        "image_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "process_id": {
          "type": "integer",
          "minimum": 1
        },
        "process_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "image_sha256": {
          "$ref": "#/$defs/lowerSha256"
        }
      }
    },
    "system": {
      "type": "object",
      "required": [
        "physical_memory_total_bytes",
        "physical_memory_available_bytes",
        "commit_limit_bytes",
        "commit_used_bytes",
        "standby_cache_bytes",
        "modified_page_list_bytes",
        "compression_store_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "physical_memory_total_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "physical_memory_available_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "commit_limit_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "commit_used_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "standby_cache_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "modified_page_list_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "compression_store_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        }
      }
    },
    "process": {
      "type": "object",
      "required": [
        "process_id",
        "process_start_utc",
        "image_sha256",
        "is_target",
        "working_set_bytes",
        "peak_working_set_bytes",
        "private_bytes",
        "virtual_size_bytes",
        "peak_virtual_size_bytes",
        "paged_memory_bytes",
        "page_fault_count",
        "hard_fault_count",
        "soft_fault_count"
      ],
      "additionalProperties": false,
      "properties": {
        "process_id": {
          "type": "integer",
          "minimum": 1
        },
        "process_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "image_sha256": {
          "$ref": "#/$defs/lowerSha256"
        },
        "is_target": {
          "type": "boolean"
        },
        "working_set_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "peak_working_set_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "private_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "virtual_size_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "peak_virtual_size_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "paged_memory_bytes": {
          "$ref": "#/$defs/byteMeasurement"
        },
        "page_fault_count": {
          "$ref": "#/$defs/countMeasurement"
        },
        "hard_fault_count": {
          "$ref": "#/$defs/countMeasurement"
        },
        "soft_fault_count": {
          "$ref": "#/$defs/countMeasurement"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "system_measurement_count",
        "process_count",
        "process_measurement_count",
        "failed_measurement_count",
        "evidence_completeness"
      ],
      "additionalProperties": false,
      "properties": {
        "system_measurement_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "process_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "process_measurement_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_measurement_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_completeness": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "failed"
          ]
        }
      }
    },
    "claims": {
      "type": "object",
      "required": [
        "working_set_equals_total_memory_cost",
        "memory_pressure_absence",
        "page_fault_absence",
        "capture_completeness"
      ],
      "additionalProperties": false,
      "properties": {
        "working_set_equals_total_memory_cost": {
          "const": false
        },
        "memory_pressure_absence": {
          "const": false
        },
        "page_fault_absence": {
          "const": false
        },
        "capture_completeness": {
          "const": "not_claimed"
        }
      }
    }
  }
}
