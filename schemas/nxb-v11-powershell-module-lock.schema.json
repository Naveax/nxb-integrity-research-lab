{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nxb:schema:nxb-v11-powershell-module-lock:v2",
  "title":"NXB V11 PowerShell module lock v2",
  "type":"object",
  "additionalProperties":false,
  "required":["authority","schema_version","modules"],
  "properties":{
    "authority":{"const":"nxb-v11-powershell-module-lock-v2"},
    "schema_version":{"const":2},
    "modules":{
      "type":"array",
      "minItems":2,
      "maxItems":2,
      "items":{"$ref":"#/$defs/module"}
    }
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gitSha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "version":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._+!-]*$"},
    "normalizedName":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "moduleName":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "relativePath":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*[\\u0000-\\u001f\\u007f:])[^/]+(?:/[^/]+)*$"},
    "module":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "normalized_name","name","version","guid","package_uri_identity",
        "package_sha256","module_manifest_relative","module_manifest_sha256",
        "extracted_tree_profile","extracted_tree_sha256","source_repository",
        "source_ref","source_ref_kind","source_tag_object_sha","source_commit_sha",
        "source_tree_sha","source_commit_verification","allowed_powershell_cells"
      ],
      "properties":{
        "normalized_name":{"$ref":"#/$defs/normalizedName"},
        "name":{"$ref":"#/$defs/moduleName"},
        "version":{"$ref":"#/$defs/version"},
        "guid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "package_uri_identity":{"type":"string","format":"uri","pattern":"^https://"},
        "package_sha256":{"$ref":"#/$defs/sha256"},
        "module_manifest_relative":{"$ref":"#/$defs/relativePath"},
        "module_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "extracted_tree_profile":{"const":"nxb-artifact-tree-manifest-v1"},
        "extracted_tree_sha256":{"$ref":"#/$defs/sha256"},
        "source_repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "source_ref":{"type":"string","pattern":"^refs/tags/[^\\u0000-\\u001f\\u007f]+$"},
        "source_ref_kind":{"enum":["lightweight_tag","annotated_tag"]},
        "source_tag_object_sha":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/gitSha"}]},
        "source_commit_sha":{"$ref":"#/$defs/gitSha"},
        "source_tree_sha":{"$ref":"#/$defs/gitSha"},
        "source_commit_verification":{"const":"verified_valid"},
        "allowed_powershell_cells":{
          "type":"array",
          "minItems":1,
          "uniqueItems":true,
          "items":{"enum":["ps74-prev-lts","ps75-stable","ps76-primary"]}
        }
      }
    }
  }
}