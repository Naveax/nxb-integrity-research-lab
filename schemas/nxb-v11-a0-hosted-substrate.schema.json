{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nxb:schema:nxb-v11-a0-hosted-substrate:v1",
  "title": "NXB V11 A0 hosted substrate document map v1",
  "description": "Strict claim-free mapping for the exact six-entry A0 hosted substrate. This schema is a logical validation envelope for the six JSON documents and is not itself a seventh review entry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "schema_version",
    "filename_set_sha256",
    "documents"
  ],
  "properties": {
    "authority": {
      "const": "nxb-v11-a0-hosted-substrate-v1"
    },
    "schema_version": {
      "const": 1
    },
    "filename_set_sha256": {
      "const": "79ca4d7140bfccd859cd2952e70f7dc636a1612ad1b475f7509e57bd4cd7c977"
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility-policy-summary.json",
        "canonicalization-conformance.json",
        "native-impact-classifier-fixtures.json",
        "known-error-scan.json",
        "independent-validation.json",
        "a0-substrate-receipt.json"
      ],
      "properties": {
        "compatibility-policy-summary.json": {
          "$ref": "#/$defs/compatibilityPolicySummary"
        },
        "canonicalization-conformance.json": {
          "$ref": "#/$defs/canonicalizationConformance"
        },
        "native-impact-classifier-fixtures.json": {
          "$ref": "#/$defs/nativeImpactClassifierFixtures"
        },
        "known-error-scan.json": {
          "$ref": "#/$defs/knownErrorScan"
        },
        "independent-validation.json": {
          "$ref": "#/$defs/independentValidation"
        },
        "a0-substrate-receipt.json": {
          "$ref": "#/$defs/a0SubstrateReceipt"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "productionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_key_used",
        "signer_used",
        "tag_mutation",
        "release_mutation",
        "merge_mutation",
        "repository_protection_mutated"
