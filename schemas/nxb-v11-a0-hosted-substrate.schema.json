    "canonicalizationConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "schema_version",
        "repository",
        "canonicalizer_module_sha256",
        "canonicalizer_wrapper_sha256",
        "fixture_set_sha256",
        "fixtures",
        "all_cases_passed",
        "historical_evidence_store_mutated"
      ],
      "properties": {
        "authority": {
          "const": "nxb-v11-a0-canonicalization-conformance-v1"
        },
        "schema_version": {
          "const": 1
        },
        "repository": {
          "const": "Naveax/nxb-integrity-research-lab"
