          "$ref": "#/$defs/sha256"
        },
        "fixture_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fixtures": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "input_sha256",
              "expected_outcome",
              "observed_powershell_outcome",
              "observed_python_outcome"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "input_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "expected_outcome": {
                "enum": [
                  "accept",
                  "reject"
                ]
              },
              "observed_powershell_outcome": {
                "enum": [
                  "accept",
                  "reject"
                ]
              },
              "observed_python_outcome": {
                "enum": [
                  "accept",
                  "reject"
                ]
              },
              "expected_canonical_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "powershell_observed_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "python_observed_sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "expected_outcome": {
                      "const": "accept"
                    }
                  }
                },
                "then": {
                  "required": [
                    "expected_canonical_sha256",
                    "powershell_observed_sha256",
                    "python_observed_sha256"
                  ]
                }
              }
            ]
          }
        },
        "all_cases_passed": {
          "const": true
        },
        "historical_evidence_store_mutated": {
          "const": false
        }
      }
    },
